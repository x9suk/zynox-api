# ─── Discord ─────────────────────────────────────────────
# Your Discord Application Client ID (from Developer Portal)
DISCORD_CLIENT_ID=your_client_id

# Your Discord Application Client Secret (from Developer Portal)
DISCORD_CLIENT_SECRET=your_client_secret

# Your Discord Bot Token (from Bot section in Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token

# OAuth2 redirect URL (must match Developer Portal OAuth2 redirects)
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/callback

# Discord API base URL (do not change unless using a custom proxy)
DISCORD_API_BASE=https://discord.com/api/v10

# Discord invite URL for the bot (optional, used for sharing)
DISCORD_INVITE_URL=

# Guild ID for development — when set, slash commands register to this guild only
# (instant update, no 1-hour cache). Leave blank for global registration.
DISCORD_GUILD_ID=

# ─── Server ──────────────────────────────────────────────
# Port the API server listens on
PORT=3000

# Host address (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
HOST=0.0.0.0

# Environment: development | production | test
NODE_ENV=development

# Frontend URL for OAuth redirect (development)
FRONTEND_URL=http://localhost:3001

# ─── JWT ─────────────────────────────────────────────────
# Secret key used to sign JWT tokens (change in production!)
JWT_SECRET=change_this_to_a_random_64_char_string

# Token expiration (e.g., 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ─── MongoDB ─────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/zynox_tracking

# ─── Redis ───────────────────────────────────────────────
# Redis server host
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis username (leave empty if none; used by Redis Cloud)
REDIS_USERNAME=

# Redis password (leave empty if none)
REDIS_PASSWORD=

# Redis database index (0-15)
REDIS_DB=0

# Enable TLS for Redis connection (set "true" for Redis Cloud)
REDIS_TLS=false

# Redis key prefix for namespacing
REDIS_PREFIX=zynox:

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Rate Limit ──────────────────────────────────────────
# Maximum requests per window per IP
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ─── API Key ─────────────────────────────────────────────
# Enable or disable API key authentication globally
API_KEY_ENABLED=true

# ─── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ─── Bot ─────────────────────────────────────────────────
# Comma-separated Discord user IDs that have bot owner privileges
BOT_OWNER_IDS=742415554840887337,869716921283653693

# Prefix for owner prefix commands (e.g. ;stats, ;ban <id>)
BOT_PREFIX=;

# ─── Logging ─────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
